# IPFS Configuration
IPFS_HOST=127.0.0.1
IPFS_PORT=5001
IPFS_PROTOCOL=http

# API Discovery Settings
API_DISCOVERY_ENABLED=true
API_DISCOVERY_INTERVAL=300000
API_VALIDATION_STRICT=true

# Real-time Streaming
WEBSOCKET_ENABLED=true
WEBSOCKET_RECONNECT_INTERVAL=5000
REST_POLLING_ENABLED=true
REST_POLLING_INTERVAL=10000

# Data Queue Settings
QUEUE_MAX_SIZE=10000
QUEUE_BATCH_SIZE=100
QUEUE_FLUSH_INTERVAL=5000

# Self-Healing Configuration
HEALTH_CHECK_INTERVAL=30000
AUTO_RECOVERY_ENABLED=true
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000

# Monitoring
METRICS_PORT=9090
METRICS_ENABLED=true
DASHBOARD_PORT=3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/system.log

# Resonance School Treasury (from existing config)
SEEDBRINGER_TREASURY=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb2
